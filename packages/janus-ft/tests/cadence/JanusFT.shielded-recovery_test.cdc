/// JanusFT.shielded-recovery_test.cdc — Cadence unit tests for JanusFT v0.8
/// shielded-recovery integration.
///
/// Run from packages/janus-ft:
///   flow test tests/cadence/JanusFT.shielded-recovery_test.cdc
///
/// Test environment requirements
/// ───────────────────────────────
/// Runs on the Flow emulator ("testing" network, 127.0.0.1:3569).
/// The emulator provides EVM at 0xf8d6e0586b0a20c7 which satisfies the EVM import.
/// JanusFlow (normally at 0x5dcbeb41055ec57e on testnet) is replaced by the
/// minimal JanusFlow_stub deployed in setup().
///
/// Cross-VM-dependent tests (full shieldedTransfer with real ZK proofs) are
/// integration tests covered by smoke-janusft-aggregate.mjs and the ECIES decode
/// verifier (tests/JanusFT.ecies-decode.test.js).
///
/// Coverage
/// ────────
///  1.  Contract deployment + MAX_BATCH_RESET == 100
///  2.  CommitmentRegistry setup (totalLocked == 0)
///  3.  Inbox installation idempotent
///  4.  Checkpoint installation idempotent
///  5.  AdminProofStoragePath equals AdminStoragePath
///  6.  adminResetSlot single slot: commitment → identity
///  7.  adminResetSlot panics for non-existent slot
///  8.  adminBatchResetSlots: 3 set + 1 nil → nil silently skipped, 3 reset
///  9.  adminBatchResetSlots reverts when users.length > 100
/// 10.  SlotReset event emitted on adminResetSlot
/// 11.  Direct inbox deposit: bytes preserved exactly (FIXTURE_CT round-trip)
/// 12.  FIFO order preserved across multiple direct deposits
/// 13.  Multi-recipient isolation (alice→bob and alice→carol independent)
/// 14.  Strict-mode: shieldedTransfer panics when recipient has no inbox
/// 15.  v0.8 event types accessible (ShieldedTransferNote + deprecated wrapper)

import Test
import BlockchainHelpers
import "JanusFT"
import "ShieldedInbox"
import "ShieldedCheckpoint"

// ---------------------------------------------------------------------------
// Test accounts
// ---------------------------------------------------------------------------

access(all) let deployer = Test.getAccount(0x0000000000000013)
access(all) let alice    = Test.createAccount()
access(all) let bob      = Test.createAccount()
access(all) let carol    = Test.createAccount()
/// dave never installs an inbox — used for strict-mode panic test
access(all) let dave     = Test.createAccount()

// ---------------------------------------------------------------------------
// Pre-computed ECIES ciphertext fixtures
// Generated by: node tests/helpers/precompute-ciphertexts.mjs
//
// Recipient: bob's deterministic BabyJub keypair (privkey = 123456789...0123n)
// Payload: {v:1, amt:"30000000", bld:"98765432109876543210987654", memo:"JanusFT-v0.8-test"}
// Decryption verified by: node tests/JanusFT.ecies-decode.test.js
// ---------------------------------------------------------------------------

access(all) let FIXTURE_EPH_X: UInt256 =
    8190521450935416532888494261730315431696489551095848138811014530828875440097
access(all) let FIXTURE_EPH_Y: UInt256 =
    7601091023953723884940914746846574365973801397252898472550077653060548372603
